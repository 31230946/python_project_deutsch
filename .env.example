# Copy this file to ".env" and fill in your real key(s).
# Never commit the real ".env" file or hardcode keys in source code.

GEMINI_API_KEY=your_primary_gemini_key_here

# Optional: a second key, used automatically if the primary one
# fails/hits its quota. Leave blank/remove the line if you don't have one.
GEMINI_API_KEY_BACKUP=

# Ollama needs no key -- it runs locally. Just make sure it's running
# and the model is pulled:
#   ollama pull qwen2.5:3b
